<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    <style>
      /* ═══════════════════════════════════════════════
         BENTO GRID HERO — fresh redesign
         ═══════════════════════════════════════════════ */

      :root {
        --bento-bg:       #06060a;
        --card-bg:        rgba(255, 255, 255, 0.03);
        --card-border:    rgba(255, 255, 255, 0.08);
        --card-hover-bg:  rgba(255, 255, 255, 0.055);
        --card-hover-border: rgba(181, 9, 172, 0.35);
        --accent:         #b509ac;
        --accent2:        #7c3aed;
        --text-primary:   #f0f0f4;
        --text-secondary: #8888a0;
        --text-muted:     #44445a;
        --gap:            14px;
        --radius:         16px;
      }

      /* ── wrapper ── */
      .om-bento-section {
        width: 100%;
        background: var(--bento-bg);
        padding: 5rem 0 4rem;
        position: relative;
        overflow: hidden;
      }

      /* subtle radial glow behind grid */
      .om-bento-section::before {
        content: '';
        position: absolute;
        top: -120px;
        left: 50%;
        transform: translateX(-50%);
        width: 900px;
        height: 600px;
        background: radial-gradient(ellipse at center,
          rgba(181, 9, 172, 0.07) 0%,
          rgba(124, 58, 237, 0.04) 40%,
          transparent 70%);
        pointer-events: none;
      }

      .om-bento-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem;
        position: relative;
        z-index: 1;
      }

      /* ── grid ── */
      .om-bento-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 300px;
        grid-template-rows: auto auto;
        gap: var(--gap);
      }

      /* ── base card ── */
      .om-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius);
        padding: 2rem;
        transition: background 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
        position: relative;
        overflow: hidden;
      }
      .om-card:hover {
        background: var(--card-hover-bg);
        border-color: var(--card-hover-border);
        transform: translateY(-2px);
      }

      /* ── CARD A: Name + bio + CTA ── */
      .om-card-name {
        grid-column: 1 / 3;
        grid-row: 1 / 2;
        padding: 2.5rem;
      }

      .om-card-eyebrow {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1.2rem;
      }
      .om-card-eyebrow::before {
        content: '';
        display: inline-block;
        width: 28px;
        height: 1.5px;
        background: var(--accent);
        opacity: 0.7;
      }

      .om-card-name h1 {
        font-size: clamp(2.6rem, 4.5vw, 4.2rem);
        font-weight: 800;
        line-height: 1.06;
        letter-spacing: -0.03em;
        color: var(--text-primary);
        margin: 0 0 1.2rem;
      }
      .om-card-name h1 .accent-dot {
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .om-tagline {
        font-size: 1rem;
        line-height: 1.7;
        color: var(--text-secondary);
        max-width: 520px;
        margin-bottom: 2rem;
      }
      .om-tagline strong {
        color: #d8d8e8;
        font-weight: 600;
      }

      .om-cta-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      .om-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 1.3rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.18s ease;
        letter-spacing: 0.01em;
      }
      .om-cta-primary {
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        color: #fff;
        border: 1px solid transparent;
      }
      .om-cta-primary:hover {
        opacity: 0.88;
        color: #fff;
        text-decoration: none;
        transform: translateY(-1px);
      }
      .om-cta-ghost {
        background: transparent;
        color: var(--text-secondary);
        border: 1px solid rgba(255,255,255,0.1);
      }
      .om-cta-ghost:hover {
        border-color: var(--accent);
        color: var(--accent);
        text-decoration: none;
      }

      /* ── CARD B: Photo ── */
      .om-card-photo {
        grid-column: 3 / 4;
        grid-row: 1 / 3;
        padding: 0;
        overflow: hidden;
      }
      .om-card-photo img {
        width: 100%;
        height: 100%;
        min-height: 360px;
        object-fit: cover;
        object-position: top center;
        display: block;
        filter: grayscale(20%) contrast(1.05);
        transition: filter 0.4s ease, transform 0.4s ease;
        border-radius: var(--radius);
      }
      .om-card-photo:hover img {
        filter: grayscale(0%) contrast(1.0);
        transform: scale(1.02);
      }

      /* ── CARD C: Affiliation ── */
      .om-card-affil {
        grid-column: 1 / 2;
        grid-row: 2 / 3;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }

      .om-pulse-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #22c55e;
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.2);
        border-radius: 20px;
        padding: 0.2rem 0.7rem;
        width: fit-content;
      }
      .om-pulse-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        animation: om-pulse-green 2s infinite;
      }
      @keyframes om-pulse-green {
        0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
        50% { opacity: 0.7; box-shadow: 0 0 0 4px rgba(34,197,94,0); }
      }

      .om-affil-name {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.2;
        margin: 0;
      }
      .om-affil-sub {
        font-size: 0.82rem;
        color: var(--text-secondary);
        margin: 0;
        font-family: 'SF Mono', 'Fira Code', monospace;
      }
      .om-affil-advisor {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: auto;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(255,255,255,0.05);
      }
      .om-affil-advisor a {
        color: var(--accent);
        text-decoration: none;
      }
      .om-affil-advisor a:hover { text-decoration: underline; }

      /* ── CARD D: Research Focus ── */
      .om-card-research {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .om-card-label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .om-research-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.35;
        margin: 0;
      }

      .om-research-desc {
        font-size: 0.82rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0;
      }

      /* KV-cache mini visualization */
      .om-kv-vis {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin: 0.25rem 0;
      }
      .om-kv-row {
        display: flex;
        gap: 3px;
        align-items: center;
      }
      .om-kv-label {
        font-size: 0.6rem;
        color: var(--text-muted);
        width: 20px;
        font-family: monospace;
        flex-shrink: 0;
      }
      .om-kv-block {
        height: 10px;
        border-radius: 2px;
        flex: 1;
        transition: opacity 0.3s ease;
      }
      .om-kv-block.kept {
        background: linear-gradient(90deg, var(--accent), var(--accent2));
        opacity: 0.85;
      }
      .om-kv-block.evicted {
        background: rgba(255,255,255,0.07);
        opacity: 1;
      }
      .om-kv-block.full {
        background: rgba(255,255,255,0.15);
        opacity: 1;
      }
      .om-kv-vis-label {
        display: flex;
        gap: 1rem;
        margin-top: 4px;
      }
      .om-kv-legend {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.6rem;
        color: var(--text-muted);
        font-family: monospace;
      }
      .om-kv-legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 1px;
      }

      .om-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: auto;
      }
      .om-tag {
        font-size: 0.68rem;
        font-weight: 600;
        padding: 0.2rem 0.65rem;
        border-radius: 6px;
        background: rgba(181, 9, 172, 0.1);
        border: 1px solid rgba(181, 9, 172, 0.2);
        color: #d060d0;
        letter-spacing: 0.02em;
      }

      /* ── Responsive ── */
      @media (max-width: 900px) {
        .om-bento-grid {
          grid-template-columns: 1fr 1fr;
          grid-template-rows: auto auto auto;
        }
        .om-card-name  { grid-column: 1 / 3; grid-row: 1; }
        .om-card-photo { grid-column: 1 / 3; grid-row: 2; min-height: 280px; }
        .om-card-affil { grid-column: 1; grid-row: 3; }
        .om-card-research { grid-column: 2; grid-row: 3; }
        .om-card-photo img { min-height: 280px; }
      }

      @media (max-width: 580px) {
        .om-bento-section { padding: 3rem 0 2.5rem; }
        .om-bento-wrap { padding: 0 1rem; }
        .om-bento-grid {
          grid-template-columns: 1fr;
          grid-template-rows: auto auto auto auto;
        }
        .om-card-name  { grid-column: 1; grid-row: 1; padding: 1.6rem; }
        .om-card-photo { grid-column: 1; grid-row: 2; }
        .om-card-affil { grid-column: 1; grid-row: 3; }
        .om-card-research { grid-column: 1; grid-row: 4; }
        .om-card-photo img { min-height: 260px; }
        .om-card-name h1 { font-size: 2.4rem; }
      }

    </style>
  </head>

  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">

    {% include header.liquid %}

    <!-- ══════════════════════ BENTO HERO ═══════════════════════ -->
    <section class="om-bento-section">
      <div class="om-bento-wrap">
        <div class="om-bento-grid">

          <!-- CARD A — Name, bio, CTA -->
          <div class="om-card om-card-name">
            <div class="om-card-eyebrow">PhD Researcher · Efficient AI</div>
            <h1>
              Om Rajendra<br>
              Kathalkar<span class="accent-dot">.</span>
            </h1>
            <p class="om-tagline">
              I work on <strong>adaptive KV-cache management</strong> for LLMs —
              making large models faster and leaner for deployment in
              resource-constrained environments.
            </p>
            <div class="om-cta-row">
              <a href="{{ '/publications/' | relative_url }}" class="om-cta-btn om-cta-primary">
                View research &rarr;
              </a>
              <a href="{{ '/journey/' | relative_url }}" class="om-cta-btn om-cta-ghost">
                My journey
              </a>
            </div>
          </div>

          <!-- CARD B — Photo -->
          <div class="om-card om-card-photo">
            <img
              src="{{ '/assets/img/om_headshot.png' | relative_url }}"
              alt="Om Rajendra Kathalkar"
            />
          </div>

          <!-- CARD C — Affiliation -->
          <div class="om-card om-card-affil">
            <span class="om-pulse-badge">
              <span class="om-pulse-dot"></span>Active PhD
            </span>
            <p class="om-affil-name">ICCS, NTUA</p>
            <p class="om-affil-sub">Athens, Greece 🇬🇷</p>
            <p class="om-affil-advisor">
              Advised by
              <a href="https://scholar.google.com/citations?user=e_-h5egAAAAJ&hl=el" target="_blank">
                Dr. Konstantinos Tserpes
              </a>
            </p>
          </div>

          <!-- CARD D — Research Focus + KV mini-vis -->
          <div class="om-card om-card-research">
            <span class="om-card-label">Current focus</span>
            <p class="om-research-title">Adaptive KV-Cache Compression</p>
            <p class="om-research-desc">
              Routing-entropy-guided eviction for long-context LLM inference.
            </p>

            <!-- mini KV-cache visualization -->
            <div class="om-kv-vis" title="KV-cache: purple = kept tokens, dim = evicted">
              <div class="om-kv-row">
                <span class="om-kv-label">L1</span>
                <div class="om-kv-block kept" style="flex:5"></div>
                <div class="om-kv-block kept" style="flex:4"></div>
                <div class="om-kv-block evicted" style="flex:3"></div>
                <div class="om-kv-block kept" style="flex:2"></div>
                <div class="om-kv-block evicted" style="flex:2"></div>
              </div>
              <div class="om-kv-row">
                <span class="om-kv-label">L2</span>
                <div class="om-kv-block kept" style="flex:6"></div>
                <div class="om-kv-block evicted" style="flex:2"></div>
                <div class="om-kv-block kept" style="flex:3"></div>
                <div class="om-kv-block evicted" style="flex:5"></div>
              </div>
              <div class="om-kv-row">
                <span class="om-kv-label">L3</span>
                <div class="om-kv-block full" style="flex:2"></div>
                <div class="om-kv-block kept" style="flex:8"></div>
                <div class="om-kv-block full" style="flex:2"></div>
                <div class="om-kv-block evicted" style="flex:4"></div>
              </div>
            </div>
            <div class="om-kv-vis-label">
              <span class="om-kv-legend">
                <span class="om-kv-legend-dot" style="background: linear-gradient(90deg,#b509ac,#7c3aed)"></span>
                kept
              </span>
              <span class="om-kv-legend">
                <span class="om-kv-legend-dot" style="background:rgba(255,255,255,0.07)"></span>
                evicted
              </span>
            </div>

            <div class="om-tags">
              <span class="om-tag">LLM Inference</span>
              <span class="om-tag">KV Compression</span>
              <span class="om-tag">MoE Routing</span>
            </div>
          </div>

        </div><!-- /grid -->
      </div><!-- /wrap -->
    </section>
    <!-- ══════════════════════════════════════════════════════════ -->

    <div class="container mt-5" role="main">
      <div class="post">
        <div class="clearfix">{{ content }}</div>

        {% if page.news and site.announcements.enabled %}
          <h2><a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a></h2>
          {% include news.liquid limit=true %}
        {% endif %}

        {% if site.latest_posts.enabled %}
          <h2><a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a></h2>
          {% include latest_posts.liquid %}
        {% endif %}

        {% if page.selected_papers %}
          <h2><a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a></h2>
          {% include selected_papers.liquid %}
        {% endif %}

        {% if page.social %}
          <div class="social">
            <div class="contact-icons">{% include social.liquid %}</div>
            <div class="contact-note">{{ site.contact_note }}</div>
          </div>
        {% endif %}

        {% if site.newsletter.enabled and site.footer_fixed %}
          {% include scripts/newsletter.liquid center=true %}
        {% endif %}
      </div>
    </div>

    {% include footer.liquid %}

    {% include scripts/jquery.liquid %}
    {% include scripts/bootstrap.liquid %}
    {% include scripts/masonry.liquid %}
    {% include scripts/mermaid.liquid %}
    {% include scripts/diff2html.liquid %}
    {% include scripts/leaflet.liquid %}
    {% include scripts/chartjs.liquid %}
    {% include scripts/echarts.liquid %}
    {% include scripts/vega.liquid %}
    {% include scripts/tikzjax.liquid %}
    {% include scripts/typograms.liquid %}
    {% include scripts/misc.liquid %}
    {% include scripts/badges.liquid %}
    {% include scripts/mathjax.liquid %}
    {% include scripts/pseudocode.liquid %}
    {% include scripts/analytics.liquid %}
    {% include scripts/progressBar.liquid %}
    {% include scripts/wechatModal.liquid %}
    {% include scripts/imageLayouts.liquid %}
    {% include scripts/jekyll_tabs.liquid %}
    {% include scripts/back_to_top.liquid %}
    {% include scripts/search.liquid %}
  </body>
</html>
